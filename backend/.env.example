# Configure one or both providers.
DISCORD_EMAIL=
DISCORD_PASSWORD=
INSTAGRAM_EMAIL=
INSTAGRAM_PASSWORD=

# Local development defaults.
HOST=127.0.0.1
PORT=3001
HEADLESS=false
FRONTEND_ORIGIN=*
POLL_INTERVAL_MS=5000

# Optional custom browser configuration.
# CUSTOM_CHROMIUM_PATH=/absolute/path/to/chromium
# DISCORD_USER_DATA_DIR=user-data
# INSTAGRAM_USER_DATA_DIR=instagram-user-data
